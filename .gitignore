# --- General / OS ---
node_modules/
.DS_Store
Thumbs.db
*.log
*.cache
.vercel
.turbo

# --- Environment Files (Never commit these) ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env.local

# --- Server (Node.js + TypeScript) ---
server/node_modules/
# The 'dist' or 'build' folders where TS is compiled to JS
server/dist/
server/build/
server/out/
# If you use tsconfig-build-info for incremental builds
*.tsbuildinfo

# --- Client (Next.js) ---
client/node_modules/
# Next.js build output
client/.next/
client/out/
# Static folder generated by some export commands
client/build/

# --- Databases / Tooling ---
# If using Prisma
/server/prisma/dev.db
/server/prisma/dev.db-journal

# Coverage reports for testing (Jest/Cypress)
coverage/
.nyc_output

# --- IDE Configs ---
.vscode/*
!.vscode/extensions.json
.idea/