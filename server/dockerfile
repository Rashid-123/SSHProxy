FROM node:20-alpine

# 1. Install system dependencies
RUN apk add --no-cache openssl

WORKDIR /app

# 2. Install dependencies (Cached layer)
COPY package*.json ./
RUN npm install

# 3. Generate Prisma Client (Cached layer)
# We copy only the prisma folder first so code changes don't trigger a re-generation
COPY prisma ./prisma/
RUN npx prisma generate

# 4. Copy source and Build
COPY . .
RUN npm run build

# 5. Clean up devDependencies to keep the image small
# This makes the image much faster to pull on EC2
RUN npm prune --production

EXPOSE 5000

CMD ["node", "dist/app.js"]